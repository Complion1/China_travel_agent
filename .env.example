# Copy to a private .m14-local/config.env and replace every REQUIRED value.
# This file is an example; the application never parses .env automatically.
WEB_PUBLIC_ORIGIN=http://127.0.0.1:8080
DEEPSEEK_API_KEY=__DEEPSEEK_API_KEY_REQUIRED__
BAIDU_MAPS_API_KEY=__BAIDU_MAPS_API_KEY_REQUIRED__
M14_LOCAL_PG_PASSWORD=your-password
M14_KEY_PATH=./.m14-local/keys/pause-key.json
# WEB_PORT is fixed to 8080 for this Compose profile; quotas remain 200/20/5.
