# Copy this file to .env and replace local values. Never commit real secrets.
DEEPSEEK_API_KEY=your-api-key

# Module 06 uses this key only in the map runtime and a separately authorized
# Baidu live Gate. Never commit a real key.
BAIDU_MAPS_API_KEY=your-baidu-maps-api-key

# Used only by the optional Compose "production" profile. The current Demo
# modules do not connect to PostgreSQL yet.
POSTGRES_DB=china_travel_agent
POSTGRES_USER=china_travel_agent
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine

# The default is reachable from many mainland-China Docker installations.
# Override with python:3.12-slim-bookworm if Docker Hub is available.
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
